{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "OrderManagement",
    "Audience": "OrderManagement.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Assistant": {
    "Provider": "Claude",
    "MaxTokens": 4096,
    "MaxToolRounds": 5,
    "Claude": { "Model": "claude-haiku-5-5" },
    "OpenAI": { "Model": "gpt-5-mini" },
    "Gemini": { "Model": "gemini-3.5-flash" },
    "Ollama": { "Endpoint": "", "Model": "qwen2.5:7b" }
  }
}
