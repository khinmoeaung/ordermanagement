{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "OrderManagement",
    "Audience": "OrderManagement.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Assistant": {
    "Provider": "Claude",
    "MaxTokens": 4096,
    "MaxToolRounds": 5,
    "Claude": { "Model": "claude-haiku-5-5" },
    "OpenAI": { "Model": "gpt-5-mini" },
    "Gemini": { "Model": "gemini-3.5-flash" },
    "Ollama": { "Endpoint": "", "Model": "qwen2.5:7b" }
  },
  "Policies": {
    "Directory": "policies",
    "Embedding": {
      "Endpoint": "",
      "Model": "qwen3-embedding:0.6b",
      "QueryInstruction": "Given a customer question about shop policies, retrieve the policy passages that answer it"
    },
    "Qdrant": { "Host": "qdrant", "GrpcPort": 6334, "Collection": "policy_chunks", "ApiKey": "" },
    "Chunking": { "MaxChars": 1500 },
    "Retrieval": { "TopK": 8, "FinalCount": 4, "RrfK": 60 }
  }
}
