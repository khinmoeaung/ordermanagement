{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "OrderManagement",
    "Audience": "OrderManagement.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Assistant": {
    "Model": "claude-opus-5-5",
    "MaxTokens": 16000,
    "Effort": "low",
    "MaxToolRounds": 5,
    "EnableFallbacks": true
  }
}
