# Copy to .env and replace every value. .env is git-ignored; never commit it.

# MySQL container
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=ordermanagement
MYSQL_USER=ordermanagement
MYSQL_PASSWORD=change-me-db-password

# API. The host is the compose service name "mysql"; user and password must match the values above.
ConnectionStrings__Default=server=mysql;port=3306;database=ordermanagement;user=ordermanagement;password=change-me-db-password

# JWT signing key: at least 32 characters (the API refuses to start otherwise).
Jwt__SigningKey=change-me-fake-signing-key-at-least-32-characters

# Seeded admin account
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=ChangeMe123

# Claude API key for POST /api/v1/assistant/chat. Optional: the assistant endpoint returns 503 without it.
ANTHROPIC_API_KEY=
