# Copy to .env and replace every value. .env is git-ignored; never commit it.

# MySQL container
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=ordermanagement
MYSQL_USER=ordermanagement
MYSQL_PASSWORD=change-me-db-password

# API. The host is the compose service name "mysql"; user and password must match the values above.
ConnectionStrings__Default=server=mysql;port=3306;database=ordermanagement;user=ordermanagement;password=change-me-db-password

# JWT signing key: at least 32 characters (the API refuses to start otherwise).
Jwt__SigningKey=change-me-fake-signing-key-at-least-32-characters

# Seeded admin account
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=ChangeMe123

# Provider keys for POST /api/v1/assistant/chat. All optional: the assistant endpoint returns 503 until the selected provider is configured.
ANTHROPIC_API_KEY=

# Assistant provider: Claude (default), OpenAI, Gemini or Ollama. Set the matching key or endpoint below.
Assistant__Provider=Claude
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama runs on another machine; no key. Example: http://192.168.1.50:11434
Assistant__Ollama__Endpoint=
Assistant__Ollama__Model=qwen2.5:7b

# Policy Q&A (RAG). Ollama on the machine that runs the embedding model (ollama pull qwen3-embedding:0.6b); no key. Example: http://192.168.1.50:11434
# Empty: POST /api/v1/policies/ask answers 503 "not configured".
Policies__Embedding__Endpoint=
# Only if your Qdrant requires an API key (the compose Qdrant does not).
Policies__Qdrant__ApiKey=
